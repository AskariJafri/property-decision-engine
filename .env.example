# Copy to .env. Never commit the copy. No real credentials belong in this file.

PDE_ENVIRONMENT=local
PDE_DEBUG=true

PDE_DATABASE_URL=postgresql+asyncpg://pde:pde@localhost:5432/pde

# The self-hosted OSM stack (ADR 0002). Leave blank and the location adapters
# return "unavailable" — a state the product renders honestly rather than a
# broken environment. Bring them up with: docker compose --profile osm up
PDE_NOMINATIM_URL=http://localhost:8081
PDE_ROUTING_URL=http://localhost:5000
PDE_OVERPASS_URL=http://localhost:8082

# OpenRouteService: the fastest way to make the Location score real. Free key at
# https://openrouteservice.org/dev/#/signup - 2,500 requests/day, no card. This is
# the development stopgap; the self-hosted OSM stack above is the production answer.
# Leave blank and commute is reported unavailable rather than guessed.
PDE_ORS_API_KEY=

# Pilot jurisdiction (ADR 0003). The second city is a config change, not a rewrite.
PDE_PILOT_JURISDICTION=ON/Toronto

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PDE_SESSION_SECRET=

PDE_ANALYSIS_RATE_LIMIT_PER_HOUR=10
PDE_LISTING_PARSE_RATE_LIMIT_PER_DAY=20

# Plain-language explanations (ADR 0004). OFF unless you turn this on, and the
# default base URL below is why: it points at localhost, which on a serverless
# host is the function's own container — a request there hangs until the timeout
# instead of failing fast. This flag is the switch. Blanking PDE_LLM_BASE_URL is
# NOT a way to turn the model off: blank values are treated as unset, so the
# default comes back.
PDE_LLM_EXPLANATIONS_ENABLED=false

# Local: install Ollama, then `ollama pull llama3.1:8b-instruct-q4_K_M`.
# Hosted: point the base URL at any OpenAI-compatible endpoint and set the key.
PDE_LLM_BASE_URL=http://localhost:11434/v1
PDE_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
PDE_LLM_API_KEY=
PDE_LLM_TEMPERATURE=0.0
PDE_LLM_SEED=7

# Separate from the generation timeout on purpose. Generating can take a minute;
# discovering that nothing is listening should take a moment.
PDE_LLM_CONNECT_TIMEOUT_SECONDS=3.0

# Set by CI and by anyone running the schema-constraint tests locally.
# PDE_TEST_DATABASE_URL=postgresql://pde:pde@localhost:5432/pde

# There are no data-provider API keys. That is the point of ADR 0002: every
# source is either open, self-hosted, or supplied by the user.

# --- Accounts, credits and billing ----------------------------------------------

# Encrypts a household's stored inputs and results. REQUIRED in staging and
# production (the API refuses to store analyses without it). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes every stored analysis unreadable.
PDE_DATA_ENCRYPTION_KEY=

# Comma-separated emails promoted to admin when they sign up or sign in.
# Server-side only. Alternative: python -m app.cli grant-role you@example.com admin
PDE_BOOTSTRAP_ADMIN_EMAILS=

# Stripe. Blank = payments not configured; checkout says so and charges nothing.
# Use test-mode keys (sk_test_...) until you are ready to take real money.
PDE_STRIPE_SECRET_KEY=
# From the webhook endpoint you create in Stripe (or `stripe listen` locally).
PDE_STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the buyer after checkout.
PDE_PUBLIC_APP_URL=http://localhost:3000

# Bearer token for scheduled jobs (POST /api/v1/internal/watch/refresh). Blank disables.
PDE_CRON_SECRET=

# Estimated AI spend per day across all users before explanations pause (cents).
# Estimated from the cost assumptions in the admin console. 0 = no cap.
PDE_AI_DAILY_BUDGET_CENTS=500

# --- Web (web/.env.local or the web project's settings) ------------------------
# Where the web app proxies /api/* to. Read at build time on Vercel.
# PDE_API_ORIGIN=http://127.0.0.1:8000
# Show labelled ad placeholders in a production build (for testing layouts only).
# NEXT_PUBLIC_AD_PLACEHOLDERS=false
